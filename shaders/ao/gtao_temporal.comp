#version 460
#define GTAO_OWN_PUSH_CONSTANTS
#include "gtao_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant, scalar) uniform GtaoTemporalConstants
{
    mat4  reproject;
    ivec2 viewportSize;
    vec2  uvToViewMul;
    vec2  uvToViewAdd;
    float maxHistory;
    float depthTolerance;
    uint  historyValid;
} tc;

layout(set = 0, binding = 0) uniform sampler2D currentAO;
layout(set = 0, binding = 1) uniform sampler2D historyIn;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D historyOut;
layout(set = 0, binding = 3) uniform sampler2D workingDepth;

bool fetchHistory(vec2 prevUV, float expectedDepth, out vec2 history)
{
    vec2  t    = prevUV * vec2(tc.viewportSize) - 0.5;
    ivec2 base = ivec2(floor(t));
    vec2  f    = t - vec2(base);

    const ivec2 offsets[4] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));
    const vec4  bilinear   = vec4((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y),
                                  (1.0 - f.x) * f.y,         f.x * f.y);

    vec2  sum       = vec2(0.0);
    float weightSum = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 p = base + offsets[i];
        if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, tc.viewportSize))) {
            continue;
        }
        vec3  h = texelFetch(historyIn, p, 0).rgb;
        float w = bilinear[i] * float(abs(h.b - expectedDepth) < tc.depthTolerance * expectedDepth);
        sum       += h.rg * w;
        weightSum += w;
    }

    if (weightSum < 0.1) {
        return false;
    }
    history = sum / weightSum;
    return true;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pix, tc.viewportSize))) {
        return;
    }

    float current = texelFetch(currentAO, pix, 0).r;
    float z       = texelFetch(workingDepth, pix, 0).r;

    if (z >= GTAO_MAX_DEPTH) {
        imageStore(historyOut, pix, vec4(current, 1.0, 0.0, 0.0));
        return;
    }

    float ao = current;
    float n  = 1.0;

    if (tc.historyValid != 0u) {
        vec2 uv       = (vec2(pix) + 0.5) / vec2(tc.viewportSize);
        vec3 P        = vec3((tc.uvToViewMul * uv + tc.uvToViewAdd) * z, z);
        vec4 prevClip = tc.reproject * vec4(P, 1.0);
        vec2 prevUV   = vec2(prevClip.x, -prevClip.y) / prevClip.w * 0.5 + 0.5;
        vec2 history;
        if (prevClip.w > 0.0 && fetchHistory(prevUV, prevClip.w, history)) {
            n  = min(history.y + 1.0, tc.maxHistory);
            ao = mix(history.x, current, 1.0 / n);
        }
    }
    imageStore(historyOut, pix, vec4(ao, n, z, 0.0));
}
