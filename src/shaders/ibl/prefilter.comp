#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly imageCube uDest;

layout(push_constant) uniform Push {
    float roughness;
    uint  mipSize;
    uint  sampleCount;
    float sourceSize;
} pc;


const float PI = 3.14159265359;

vec3 faceDirection(uint face, vec2 uv) {
    switch(face) {
        case 0u: return vec3( 1.0, -uv.y, -uv.x); // +X
        case 1u: return vec3(-1.0, -uv.y,  uv.x); // -X
        case 2u: return vec3( uv.x,  1.0,  uv.y); // +Y
        case 3u: return vec3( uv.x, -1.0, -uv.y); // -Y
        case 4u: return vec3( uv.x, -uv.y,  1.0); // +Z
        case 5u: return vec3(-uv.x, -uv.y, -1.0); // -Z
    }
    return vec3(0.0);
}


// https://learnopengl.com/PBR/IBL/Specular-IBL
vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness)
{
    float a = roughness*roughness;

    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a*a - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta*cosTheta);

    // from spherical coordinates to cartesian coordinates
    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;

    // from tangent-space vector to world-space sample vector
    vec3 up        = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent   = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    vec3 sampleVec = tangent * H.x + bitangent * H.y + N * H.z;
    return normalize(sampleVec);
}


float D_GGX(float NdotH, float alpha)
{
    float a2 = alpha * alpha;
    float d  = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

float radicalInverse(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hemmersley(uint i, uint n)
{
    return vec2(float(i) / float(n), radicalInverse(i));
}

void main(){
    // 1. bounds check against pc.mipSize
    uvec2 coord = gl_GlobalInvocationID.xy;
    if (coord.x >= pc.mipSize || coord.y >= pc.mipSize) return;

    vec2 uv = (vec2(coord) + 0.5) / float(pc.mipSize) * 2.0 - 1.0;

    // 2. N = R = V = faceDirection(gl_GlobalInvocationID.z, uv)
    vec3 N = normalize(faceDirection(gl_GlobalInvocationID.z, uv));
    vec3 R = N;
    vec3 V = R;

    float alpha = pc.roughness * pc.roughness;

    //solid angle of one texel
    float saTexel = 4.0 * PI / (6.0 * pc.sourceSize * pc.sourceSize);

    vec3  color  = vec3(0.0);
    float weight = 0.0;


    for (uint i = 0u; i < pc.sampleCount; ++i) {
        vec2 Xi = hammersley(i, pc.sampleCount);
        vec3 H  = importanceSampleGGX(Xi, N, alpha);
        vec3 L  = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = dot(N, L);
        if (NdotL <= 0.0) continue;

        // Pick a source mip whose texel covers roughly the solid angle this
        // sample represents. Against "fireflies"
        float NdotH = max(dot(N, H), 0.0);
        float HdotV = max(dot(H, V), 0.0);
        float pdf   = D_GGX(NdotH, alpha) * NdotH / (4.0 * HdotV) + 1e-4;

        float saSample = 1.0 / (float(pc.sampleCount) * pdf + 1e-4);
        float mipLevel = pc.roughness == 0.0
        ? 0.0
        : 0.5 * log2(saSample / saTexel);

        color  += textureLod(uSource, L, mipLevel).rgb * NdotL;
        weight += NdotL;
    }

    color /= max(weight, 1e-4);
    imageStore(uDest, ivec3(ivec2(coord), int(face)), vec4(color, 1.0));
}